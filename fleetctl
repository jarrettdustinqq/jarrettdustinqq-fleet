#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

enable_jacs_preflight() {
  local data_home state_dir
  data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
  state_dir="${FLEET_CONTROL_HUB_STATE_DIR:-${data_home}/fleet-control-hub}"
  export JACS_PREFLIGHT_REQUIRED="${JACS_PREFLIGHT_REQUIRED:-1}"
  export JACS_PREFLIGHT_JSON="${JACS_PREFLIGHT_JSON:-${state_dir}/jacs_preflight.json}"
  export JACS_STALE_JOURNAL="${JACS_STALE_JOURNAL:-${state_dir}/jacs_stale_events.jsonl}"
}

usage() {
  cat <<'USAGE'
Usage:
  fleetctl install-nix                Install Nix in user mode
  fleetctl bootstrap [repo_url ...]   Create SSH key, clone/update repos
  fleetctl health                     Run local controller health checks
  fleetctl host-audit [options]       Create reversible host evidence and Git backup
  fleetctl remote-agent [options]     Handle SSH key + GitHub/VPS auth checks
  fleetctl vps-discover [options]     Find likely VPS targets from local context
  fleetctl chat-agent [options]       Synthesize open/saved Codex chats and priorities
  fleetctl chat-agent-timer [options] Install/manage hourly chat-agent timer
  fleetctl venture-agent [options]    Analyze repos and generate autonomy optimization queue
  fleetctl venture-agent-timer [options]
                                      Install/manage daily venture-agent timer
  fleetctl mission-control [options]  Run chat+venture inventory, then launch unified hub
  fleetctl hub-scan [options]         Scan inventory into Control Hub DB
  fleetctl hub-serve [options]        Run scan + local Control Hub dashboard
  fleetctl hub-runtime [options]      Manage non-root state, service, and backups
  fleetctl shell                      Enter nix dev shell (requires nix)
USAGE
}

cmd="${1:-}"
shift || true

case "$cmd" in
  install-nix)
    exec "$DIR/install_nix.sh" "$@"
    ;;
  bootstrap)
    exec "$DIR/bootstrap.sh" "$@"
    ;;
  health)
    exec "$DIR/healthcheck.sh" "$@"
    ;;
  host-audit)
    exec bash "$DIR/ops/fleet_host_remediation.sh" "$@"
    ;;
  remote-agent)
    exec "$DIR/ops/remote_access_agent.sh" "$@"
    ;;
  vps-discover)
    exec python3 "$DIR/ops/vps_discovery_agent.py" "$@"
    ;;
  chat-agent)
    exec python3 "$DIR/ops/chat_work_agent.py" "$@"
    ;;
  chat-agent-timer)
    exec "$DIR/ops/install_chat_work_agent_timer.sh" "$@"
    ;;
  venture-agent)
    exec python3 "$DIR/ops/venture_autonomy_agent.py" "$@"
    ;;
  venture-agent-timer)
    exec "$DIR/ops/install_venture_agent_timer.sh" "$@"
    ;;
  mission-control)
    enable_jacs_preflight
    exec python3 "$DIR/ops/mission_control_agent.py" "$@"
    ;;
  hub-scan)
    enable_jacs_preflight
    exec python3 "$DIR/ops/control_hub_safe_entry.py" scan "$@"
    ;;
  hub-serve)
    enable_jacs_preflight
    if ! command -v sqlite3 >/dev/null 2>&1; then
      printf '[warn] sqlite3 not found in PATH; CLI DB checks will fail.\n' >&2
      printf "[warn] install sqlite3 to run: sqlite3 ~/.local/share/fleet-control-hub/control_hub.db '.tables'\n" >&2
    fi
    exec python3 "$DIR/ops/control_hub_safe_entry.py" scan-serve "$@"
    ;;
  hub-runtime)
    enable_jacs_preflight
    exec python3 "$DIR/ops/control_hub_runtime.py" "$@"
    ;;
  shell)
    exec nix develop "$DIR" -c "${SHELL:-bash}"
    ;;
  *)
    usage
    exit 1
    ;;
esac
